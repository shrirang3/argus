# --- providers -------------------------------------------------------------
# Open-weight models only — no closed-weight provider is wired into this stack.
GROQ_API_KEY=
# optional, for the multi-provider demo. Cerebras serves open-weight models
# (Llama, Qwen) behind an OpenAI-wire compatible endpoint.
CEREBRAS_API_KEY=

# mock needs no key and streams canned tokens — the stack works out of the box.
# Set to groq or cerebras once the matching key above is filled in.
DEFAULT_PROVIDER=mock
ROUTER_MODEL=openai/gpt-oss-20b
ANSWER_MODEL=openai/gpt-oss-120b
CEREBRAS_MODEL=llama-3.3-70b

# --- infra -----------------------------------------------------------------
# Service-to-service hostnames. From your host, the same databases are published
# on localhost:5433 and localhost:6380 — remapped to avoid colliding with a
# locally installed Postgres or Redis.
DATABASE_URL=postgresql+asyncpg://argus:argus@postgres:5432/argus
REDIS_URL=redis://redis:6379/0
STREAM_NAME=llm.inference.v1
CONSUMER_GROUP=ingest-workers

# --- argus sdk -------------------------------------------------------------
ARGUS_ENDPOINT=http://ingestion:8001/v1/events
ARGUS_ENABLED=true
ARGUS_REDACT=true
ARGUS_SPILL_PATH=/var/log/argus/spill.jsonl

# --- app -------------------------------------------------------------------
CONTEXT_WINDOW_TURNS=10
MAX_AGENT_STEPS=4
LOG_LEVEL=INFO
