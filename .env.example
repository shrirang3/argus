# --- providers -------------------------------------------------------------
GROQ_API_KEY=
# optional, for the multi-provider demo
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

DEFAULT_PROVIDER=groq
ROUTER_MODEL=llama-3.1-8b-instant
ANSWER_MODEL=llama-3.3-70b-versatile

# --- infra -----------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://argus:argus@postgres:5432/argus
REDIS_URL=redis://redis:6379/0
STREAM_NAME=llm.inference.v1
CONSUMER_GROUP=ingest-workers

# --- argus sdk -------------------------------------------------------------
ARGUS_ENDPOINT=http://ingestion:8001/v1/events
ARGUS_ENABLED=true
ARGUS_REDACT=true
ARGUS_SPILL_PATH=/var/log/argus/spill.jsonl

# --- app -------------------------------------------------------------------
CONTEXT_WINDOW_TURNS=10
MAX_AGENT_STEPS=4
LOG_LEVEL=INFO
